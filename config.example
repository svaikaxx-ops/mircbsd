# mircBSD konfigūracijos pavyzdys
# Kopijuoti į: ~/.config/mircbsd/config

# IRC serveris
server=irc.libera.chat
port=6697
tls=true

# Identitetas
nick=manick
realname=Mano Vardas

# NickServ autentifikacija (neprivaloma, senasis būdas)
# nickserv=slaptazodis

# SASL PLAIN autentifikacija (rekomenduojama Libera.chat, OFTC ir kt.)
# Vartotojo vardas = nick laukas viršuje
# sasl=slaptazodis

# Serverio slaptažodis (PASS komanda) — bouncer arba privatus serveris.
# Siunčiamas prieš NICK, kaip reikalauja RFC 2812.
# password=slaptazodis

# Automatiškai prisijungti prie kanalų paleidus
# autojoin=#linux,#freebsd,#lietuviai

# Žurnalo katalogus (numatytasis: ~/irclogs)
# logdir=~/irclogs

# Automatinis prisijungimas iš naujo nutrūkus ryšiui
reconnect=true

# Maksimalus žinučių skaičius kanalų atmintyje (numatytasis: 5000)
# maxmessages=5000

# Bendras visų langų žinučių atminties biudžetas, MB (numatytasis: 256).
# Viršijus — seniausios didžiausio lango eilutės trinamos pirmos.
# maxmemory=256

# Atsakyti į CTCP VERSION užklausas
# ctcpversion=true

# Komandos vykdomos po prisijungimo (atskiriamos kabliataškiu)
# perform=/msg BotServ !register; /join #test

# Papildomi žodžiai highlight'inimui (atskiriami kableliu)
# highlight_words=linux,freebsd

# Desktop pranešimai (notify-send), kai tave paryškina neaktyviame kanale
# notifications=true

# Pelė palaikymas: ratukas scroll'ui, paspaudimas kanalo juostoje
# mouse=true

# Highlight fono spalva: red (numatyta), blue, green, magenta, cyan, yellow, none
# highlight_color=red

# Nick'ų spalvinimas (kada kiekvienas nick turi savo spalvą)
# nick_colors=true

# Kitų join/part/quit/nick eilutės (judriuose kanaluose jos užgožia
# pokalbį; jos ir taip piešiamos blankia spalva):
#   all   — visos (numatyta)
#   smart — tik nick'ų, kalbėjusių kanale per pastarąsias 10 min.
#   none  — jokių
# Paslėptos eilutės lieka žurnaluose. Keičiama ir gyvai: /set show_joins smart
# show_joins=all

# Kanalų sąrašas kairėje: auto (slepiamas < 80 stulpelių — telefonas,
# Termux), on, off. Alt+B perjungia; gyvai: /set sidebar off
# sidebar=auto

# Laiko žymos prie žinučių (15:04 formatu, numatytai įjungta)
# timestamps=true
# ts_format=15:04

# Laiko žymos spalva: gray (numatyta), blue, green, cyan, none
# tscolor=gray

# Tema: dark (numatyta — ryški paletė) arba light (šviesiems fonams —
# tamsesnė nick'ų paletė)
# theme=dark

# SASL EXTERNAL — autentifikacija kliento sertifikatu (be slaptažodžio).
# Reikia TLS (tls=true) ir abiejų failų; sasl= nebereikia.
# tls_cert=~/.config/mircbsd/cert.pem
# tls_key=~/.config/mircbsd/key.pem
# sasl_external=true

# TLS serverio sertifikato atspaudo (fingerprint) pinning (v0.4.8).
# TOFU (Trust On First Use): pirmo jungimo atspaudas išsaugomas
# configDir/fingerprints; vėlesniais jungimais nerodant kita atspaudą —
# ryšys NUTRAUKIAMAS (galimas MITM). tls_pin — rankinis atspaudas:
# sha256 hex (SPKI), jis turi pirmenybę.
# tls_pinning=false
# tls_pin=
